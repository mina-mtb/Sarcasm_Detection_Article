% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=accentpurple}

% Headline
\setbeamercolor{headline}{fg=white,bg=darkpurple}

% Block
\setbeamercolor{block title}{fg=darkpurple,bg=white}
\setbeamercolor{block separator}{bg=accentpurple}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=darkpurple,bg=palepurple}
\setbeamercolor{block alerted separator}{bg=accentpurple}
\setbeamercolor{block alerted body}{fg=black,bg=palepurple}

% Example Block
\setbeamercolor{block example title}{fg=darkpurple,bg=softgray}
\setbeamercolor{block example separator}{bg=accentpurple}
\setbeamercolor{block example body}{fg=black,bg=softgray}

% Main finding band
\setbeamercolor{mainfinding}{fg=black,bg=palepurple}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=accentpurple}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
