\definecolor{accentpurple}{RGB}{104,61,170}
\definecolor{lightaccentpurple}{RGB}{185,158,224}
\definecolor{darkpurple}{RGB}{47,27,70}
\definecolor{accentteal}{RGB}{0,137,123}
\definecolor{accentamber}{RGB}{230,159,0}
\definecolor{palepurple}{RGB}{243,238,250}
\definecolor{paleteal}{RGB}{232,247,244}
\definecolor{softamber}{RGB}{255,247,229}
\definecolor{softgray}{RGB}{247,247,248}
\definecolor{chalmblack}{RGB}{0,0,0}
